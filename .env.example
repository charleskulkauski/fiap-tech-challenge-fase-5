# Copie este arquivo para .env e preencha com as suas chaves.
# NUNCA versione o .env real.

# Azure OpenAI (portal Azure > recurso OpenAI > Keys and Endpoint)
AZURE_OPENAI_API_KEY=coloque-sua-chave-aqui
AZURE_OPENAI_ENDPOINT=https://seu-recurso.openai.azure.com

# Nome do deployment criado no Azure AI Foundry (ex.: gpt-4o-mini)
AZURE_OPENAI_DEPLOYMENT=gpt-4o-mini
AZURE_OPENAI_API_VERSION=2024-08-01-preview